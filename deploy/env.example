# /opt/mypos/<env>/.env  — lives ONLY on the server (created by setup, never committed).
ENV_NAME=staging
WEB_PORT=8080
PUBLIC_URL=http://YOUR-SERVER-IP:8080
ASPNET_ENV=Staging

WEB_IMAGE=ghcr.io/fashraf/mypos-web
WEB_TAG=latest
API_IMAGE=ghcr.io/fashraf/mypos-api
API_TAG=latest

DB_NAME=MyPosDB_Staging
DB_SA_PASSWORD=change-me-Strong#1
APP_DB_USER=mypos_app
APP_DB_PASSWORD=change-me-Strong#2
JWT_SIGNING_KEY=change-me-64-random-characters
# Keep this many old images for instant rollback
KEEP_RELEASES=5
